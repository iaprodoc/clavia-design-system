{
  "name": "@clavia-ds/storybook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:catalog-stats": "node scripts/generate-catalog-stats.mjs",
    "generate:recent-updates": "node scripts/generate-recent-updates.mjs",
    "prebuild": "pnpm run generate:recent-updates && pnpm run generate:catalog-stats && pnpm --filter @clavia-ds/tokens build && pnpm --filter @clavia-ds/icons build && pnpm --filter @clavia-ds/ui build",
    "build": "storybook build",
    "prestorybook": "pnpm run generate:recent-updates && pnpm run generate:catalog-stats",
    "storybook": "storybook dev --port 6006",
    "test": "vitest run --project=storybook",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@clavia-ds/icons": "workspace:*",
    "@clavia-ds/tokens": "workspace:*",
    "@clavia-ds/ui": "workspace:*",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/sora": "^5.2.8",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "recharts": "2.15.4"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.4.0",
    "@storybook/addon-docs": "^10.4.0",
    "@storybook/addon-vitest": "^10.4.0",
    "@storybook/react-vite": "^10.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitest/browser-playwright": "4.1.10",
    "playwright": "^1.57.0",
    "storybook": "^10.4.0",
    "vitest": "4.1.10"
  }
}
