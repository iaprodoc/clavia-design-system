{
  "name": "@clavia-ds/ui",
  "version": "1.0.0",
  "description": "Componentes React do design system da Clavia.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iaprodoc/clavia-design-system.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/iaprodoc/clavia-design-system#readme",
  "bugs": {
    "url": "https://github.com/iaprodoc/clavia-design-system/issues"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "./dist/styles.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "dependencies": {
    "@clavia-ds/icons": "workspace:*",
    "@clavia-ds/tokens": "workspace:*",
    "react-aria-components": "1.20.0"
  },
  "dependenciesMeta": {
    "@clavia-ds/icons": {
      "injected": true
    }
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json && node scripts/fix-esm-imports.mjs && node scripts/copy-static.mjs",
    "pack:check": "pnpm build && node ../../scripts/pack-check.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
