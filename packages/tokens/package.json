{
  "name": "@clavia-ds/tokens",
  "version": "1.0.0",
  "description": "Tokens do design system da Clavia — custom properties CSS, objeto tipado e JSON no formato W3C DTCG.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iaprodoc/clavia-design-system.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://github.com/iaprodoc/clavia-design-system#readme",
  "bugs": {
    "url": "https://github.com/iaprodoc/clavia-design-system/issues"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./css": "./dist/tokens.css",
    "./json": "./dist/tokens.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-static.mjs",
    "pack:check": "pnpm build && node ../../scripts/pack-check.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
